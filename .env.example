NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# Development behavior
CONTENT_MODE=mock
INQUIRY_MODE=mock

# Server-side n8n inquiry integration
N8N_INQUIRY_WEBHOOK_URL=https://n8n.aihoc.ai.vn/webhook/portfolio/inquiry
N8N_INQUIRY_HMAC_SECRET=local_dev_inquiry_secret_32_bytes_min
N8N_REQUEST_TIMEOUT_MS=10000

# Publisher integration; normally used by n8n/publish worker, not browser
GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
N8N_PUBLISH_HMAC_SECRET=local_dev_publish_secret_32_bytes_min

# Runtime protection and operations
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
CONTENT_SNAPSHOT_PATH=./src/content/generated
GENERATED_MEDIA_PATH=./public/media/generated
LOG_LEVEL=info
