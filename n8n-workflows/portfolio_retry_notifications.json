        "options": {}
      },
      "id": "mark-sent",
      "name": "Mark SENT in Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.3,
      "position": [
        1200,
        288
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "PWP0jEt8UfzeWh3W",
          "name": "Google Sheets account - Zally"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Combine filtered lead ID with SENT status\nconst unsent = $items('Filter Unsent Leads');\nreturn unsent.map(item => ({\n  json: {\n    lead_id: item.json.lead_id,\n    owner_notification_status: 'SENT'\n  }\n}));"
      },
      "id": "prepare-update-lead",
      "name": "Prepare Lead for Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
